<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_list" model="ir.ui.view">
        <field name="name">bengkel_service.order.list</field>
        <field name="model">bengkel_service.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="mechanic_id"/>
                <field name="date_in"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total"/>
            </list>
        </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">bengkel_service.order.form</field>
        <field name="model">bengkel_service.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_diagnosa" string="Diagnosa" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_proses" string="Proses" type="object" class="btn-primary" invisible="state != 'diagnosa'"/>
                    <button name="action_done" string="Selesai" type="object" class="btn-primary" invisible="state != 'proses'"/>
                    <button name="action_cancel" string="Batal" type="object" class="btn-danger" invisible="state not in ['draft', 'diagnosa', 'proses']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,diagnosa,proses,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="mechanic_id"/>
                            <field name="date_in"/>
                        </group>
                    </group>
                    <group>
                        <field name="complaint"/>
                        <field name="diagnosis"/>
                    </group>
                    <notebook>
                        <page string="Item Pekerjaan">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="currency_id" invisible="1"/>
                                <field name="total"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_order_search" model="ir.ui.view">
        <field name="name">bengkel_service.order.search</field>
        <field name="model">bengkel_service.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_proses" string="Dikerjakan" domain="[('state', '=', 'proses')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_order" model="ir.actions.act_window">
        <field name="name">Work Order</field>
        <field name="res_model">bengkel_service.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


    <record id="view_order_kanban" model="ir.ui.view">
        <field name="name">bengkel_service.order.kanban</field>
        <field name="model">bengkel_service.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" group_create="false" >
                <field name="state" />
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div>
                            <field name="vehicle_id"/>
                        </div>
                        <div class="text-muted">
                            <field name="customer_id"/>
                        </div>
                        <div>
                            <field name="mechanic_id"/>
                        </div>
                        <div>
                            <field name="total" widget="monetary"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>